package com.example.visordoble

import android.content.Context
import android.graphics.Matrix
import android.util.AttributeSet
import android.view.GestureDetector
import android.view.MotionEvent
import android.view.ScaleGestureDetector
import androidx.appcompat.widget.AppCompatImageView

class ZoomImageView @JvmOverloads constructor(context: Context, attrs: AttributeSet? = null) : AppCompatImageView(context, attrs) {
    private val matrix = Matrix()
    private val scaleDetector: ScaleGestureDetector
    private var scaleFactor = 1f
    private var lastX = 0f
    private var lastY = 0f
    private var posX = 0f
    private var posY = 0f

    init {
        scaleType = ScaleType.MATRIX
        scaleDetector = ScaleGestureDetector(context, object : ScaleGestureDetector.SimpleOnScaleGestureListener() {
            override fun onScale(detector: ScaleGestureDetector): Boolean {
                scaleFactor *= detector.scaleFactor
                scaleFactor = scaleFactor.coerceIn(0.5f, 5f)
                updateMatrix()
                return true
            }
        })
    }

    private val gestureDetector = GestureDetector(context, object : GestureDetector.SimpleOnGestureListener(){
        override fun onDoubleTap(e: MotionEvent): Boolean {
            scaleFactor = 1f; posX = 0f; posY = 0f
            updateMatrix()
            return true
        }
    })

    private fun updateMatrix() {
        matrix.reset()
        matrix.postScale(scaleFactor, scaleFactor, width/2f, height/2f)
        matrix.postTranslate(posX, posY)
        imageMatrix = matrix
    }

    override fun onTouchEvent(event: MotionEvent): Boolean {
        gestureDetector.onTouchEvent(event)
        scaleDetector.onTouchEvent(event)
        when (event.actionMasked) {
            MotionEvent.ACTION_DOWN -> { lastX = event.x; lastY = event.y }
            MotionEvent.ACTION_MOVE -> {
                if (!scaleDetector.isInProgress && scaleFactor > 1f) {
                    posX += event.x - lastX
                    posY += event.y - lastY
                    updateMatrix()
                    lastX = event.x; lastY = event.y
                }
            }
        }
        return true
    }
}
package com.example.visordoble

import android.net.Uri
import android.os.Bundle
import android.widget.Button
import android.widget.MediaController
import android.widget.VideoView
import androidx.activity.result.contract.ActivityResultContracts
import androidx.appcompat.app.AppCompatActivity

class MainActivity : AppCompatActivity() {
    private lateinit var image1: ZoomImageView
    private lateinit var video1: VideoView
    private lateinit var image2: ZoomImageView
    private lateinit var video2: VideoView
    private var activeSlot = 1

    private val pickMedia = registerForActivityResult(ActivityResultContracts.GetContent()) { uri: Uri? ->
        uri?.let {
            val type = contentResolver.getType(it) ?: ""
            val isVideo = type.startsWith("video")
            if (activeSlot == 1) showMedia(it, isVideo, image1, video1)
            else showMedia(it, isVideo, image2, video2)
        }
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)
        image1 = findViewById(R.id.image1)
        video1 = findViewById(R.id.video1)
        image2 = findViewById(R.id.image2)
        video2 = findViewById(R.id.video2)
        findViewById<Button>(R.id.btn1).setOnClickListener { activeSlot = 1; pickMedia.launch("*/*") }
        findViewById<Button>(R.id.btn2).setOnClickListener { activeSlot = 2; pickMedia.launch("*/*") }
    }

    private fun showMedia(uri: Uri, isVideo: Boolean, imageView: ZoomImageView, videoView: VideoView) {
        if (isVideo) {
            imageView.visibility = ZoomImageView.GONE
            videoView.visibility = VideoView.VISIBLE
            videoView.setVideoURI(uri)
            val mc = MediaController(this)
            mc.setAnchorView(videoView)
            videoView.setMediaController(mc)
            videoView.start()
        } else {
            videoView.visibility = VideoView.GONE
            imageView.visibility = ZoomImageView.VISIBLE
            imageView.setImageURI(uri)
        }
    }
}
